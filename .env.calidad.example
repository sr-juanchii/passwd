# ==========================================================================
#  passwd — PLANTILLA DE CALIDAD (QA / testing)
#  Ambiente para pruebas funcionales y de integración. Datos desechables;
#  claves y BD propias. Pensado para iterar rápido (sin correo por defecto).
#
#  Copia a `.env` en el servidor/host de QA.
#  Arranque típico (MySQL como en prod, para detectar fallos específicos del
#  motor antes de subir):
#    docker compose -f docker-compose.yml \
#                   -f docker-compose.frontend.yml \
#                   -f docker-compose.mysql.yml up -d --build
# ==========================================================================

# --- Identidad / acceso por nginx ------------------------------------------
PASSWD_DOMAIN=qa.passwd.empresa.local

# --- Administrador inicial (solo primer arranque) --------------------------
PASSWD_ADMIN_USERNAME=admin
PASSWD_ADMIN_EMAIL=admin-qa@empresa.local
PASSWD_ADMIN_PASSWORD=CAMBIAR-QA-Unico-2026!

# --- Claves criptográficas (propias de QA; pueden regenerarse al resetear) -
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSWD_SECRET_KEY=
PASSWD_ENCRYPTION_KEY=

# --- Base de datos: MySQL (mismo motor que prod para fidelidad) ------------
MYSQL_PASSWORD=CAMBIAR_clave_mysql_qa
# Alternativa rápida sin MySQL (datos en SQLite, cero infraestructura):
#   comenta MYSQL_PASSWORD y NO uses el overlay docker-compose.mysql.yml.

# --- Sesiones y cookies -----------------------------------------------------
# true si QA va detrás de nginx/TLS (recomendado). Si QA es HTTP plano, false.
PASSWD_COOKIE_SECURE=true
PASSWD_SESSION_IDLE_MINUTES=30   # algo más holgado para pruebas manuales
PASSWD_SESSION_MAX_HOURS=8

# --- Política de cuentas y tasa (un poco más holgado para no bloquearte) ---
PASSWD_PASSWORD_MIN_LENGTH=12
PASSWD_MAX_FAILED_ATTEMPTS=10
PASSWD_LOCKOUT_MINUTES=5
PASSWD_LOGIN_RATE_LIMIT=50
PASSWD_LOGIN_RATE_WINDOW_MINUTES=5
PASSWD_REVEAL_RATE_LIMIT=100
PASSWD_REVEAL_RATE_WINDOW_MINUTES=5
PASSWD_RATE_LIMIT_BACKEND=memoria
PASSWD_MAX_REQUEST_BYTES=65536
# IP real del cliente tras nginx (igual que prod; omite si QA va sin proxy)
PASSWD_TRUSTED_PROXIES=*

# --- Auditoría y rotación (retención corta; datos desechables) -------------
PASSWD_AUDIT_RETENTION_DAYS=90
PASSWD_ROTATION_MAX_DAYS=90
PASSWD_PASSWORD_HISTORY_MAX=5

# --- MFA --------------------------------------------------------------------
PASSWD_TOTP_ISSUER=passwd-QA

# --- Notificaciones (desactivadas por defecto en QA para evitar ruido) -----
PASSWD_NOTIFY_ENABLED=false
# Si necesitas probar el correo, habilítalo y apunta a una bandeja de pruebas:
# PASSWD_SMTP_HOST=smtp.empresa.local
# PASSWD_SMTP_PORT=587
# PASSWD_SMTP_USER=passwd-qa@empresa.local
# PASSWD_SMTP_PASSWORD=CAMBIAR_clave_smtp
# PASSWD_SMTP_FROM=passwd-qa@empresa.local
# PASSWD_SMTP_TLS=true
# PASSWD_NOTIFY_TO=qa@empresa.local
