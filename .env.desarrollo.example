# ==========================================================================
#  passwd — PLANTILLA DE DESARROLLO (local)
#  Para trabajar en tu máquina sin TLS ni MySQL: SQLite + cookies no-Secure.
#  Copia a `.env` y arranca el backend directo:
#    docker compose up -d --build           # backend en 127.0.0.1:8000 (web Jinja)
#  o, sin Docker:
#    uvicorn app.main:app --reload
#  El frontend Next se levanta aparte (cd frontend && pnpm dev) y proxia a :8000.
# ==========================================================================

# --- Identidad --------------------------------------------------------------
PASSWD_DOMAIN=localhost

# --- Administrador inicial (solo primer arranque) --------------------------
PASSWD_ADMIN_USERNAME=admin
PASSWD_ADMIN_EMAIL=admin@dev.local
PASSWD_ADMIN_PASSWORD=Desarrollo-Local-2026!

# --- Claves criptográficas --------------------------------------------------
# En desarrollo puedes dejarlas vacías: se autogeneran en ./data y persisten
# mientras no borres esa carpeta. (En prod/preprod SÍ deben fijarse.)
# PASSWD_SECRET_KEY=
# PASSWD_ENCRYPTION_KEY=

# --- Base de datos ----------------------------------------------------------
# Vacío = SQLite en ./data/passwd.db (sin configuración). Para probar MySQL en
# local puedes usar el overlay docker-compose.mysql.yml + MYSQL_PASSWORD.
# PASSWD_DATABASE_URL=

# --- Sesiones y cookies -----------------------------------------------------
# Sin HTTPS en local, la cookie Secure NO viajaría: desactívala SOLO en dev.
PASSWD_COOKIE_SECURE=false
PASSWD_SESSION_IDLE_MINUTES=60
PASSWD_SESSION_MAX_HOURS=12

# --- Política / tasa (holgado para desarrollar sin trabas) -----------------
PASSWD_PASSWORD_MIN_LENGTH=12
PASSWD_MAX_FAILED_ATTEMPTS=20
PASSWD_LOGIN_RATE_LIMIT=100
PASSWD_REVEAL_RATE_LIMIT=200
PASSWD_RATE_LIMIT_BACKEND=memoria

# --- MFA --------------------------------------------------------------------
PASSWD_TOTP_ISSUER=passwd-DEV

# --- Notificaciones (apagadas en local) ------------------------------------
PASSWD_NOTIFY_ENABLED=false
