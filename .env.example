# Referencia COMPLETA de todas las variables (con valores por defecto).
#
# Para un ambiente concreto, parte de la plantilla correspondiente — están
# afinadas por propósito (ver docs/ambientes.md):
#   .env.desarrollo.example     → local (SQLite, sin TLS)
#   .env.calidad.example        → QA / pruebas
#   .env.preproduccion.example  → staging (réplica de prod)
#   .env.produccion.example     → producción
#
# Flujo: copia la plantilla del ambiente a `.env`, rellena los secretos y
# despliega. NUNCA versiones un `.env` real (solo se versionan los *.example).

# --- Administrador inicial (solo se usa si no existen usuarios) -------------
PASSWD_ADMIN_USERNAME=admin
PASSWD_ADMIN_EMAIL=admin@su-organizacion.tld
# Contraseña de un solo uso: el sistema fuerza su cambio en el primer acceso
PASSWD_ADMIN_PASSWORD=CambiarEsteValorInicial!2026

# --- Claves criptográficas ---------------------------------------------------
# Si se omiten, se generan automáticamente y se guardan con permisos 0600 en
# el directorio de datos (modo SOLO desarrollo: la clave conviviría con la BD).
# En producción fíjalas por entorno desde un gestor de secretos y activa el
# modo estricto para que la app no arranque sin ellas.
# PASSWD_REQUIRE_ENV_KEYS=false
# PASSWD_SECRET_KEY=
# PASSWD_ENCRYPTION_KEY=   # clave Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PASSWD_AUDIT_KEY=        # firma HMAC de la bitácora: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotación de la clave de cifrado: PASSWD_ENCRYPTION_KEY admite varias claves
# separadas por comas ("nueva,antigua"): la primera cifra, todas descifran.
# Tras `python -m app.cli recifrar`, deja solo la nueva.
# PASSWD_AUDIT_KEY firma la cadena de auditoría. Sin ella el encadenamiento es un
# SHA-256 público que cualquiera con escritura en la base de datos puede recalcular.

# --- Gobernanza de rotación (ver docs/manual-administrador.md §4 bis) --------
# Cambiar la contraseña de una credencial exige una solicitud con motivo y la
# autorización de OTRO administrador, con su contraseña y su código TOTP.
# PASSWD_ROTACION_TEMPRANA_PCT=25               # % de vigencia por debajo del cual es "temprana"
# PASSWD_ROTACION_EMERGENCIA_VENTANA_MIN=60     # ventana del break-glass de un solo admin
# PASSWD_ROTACION_EMERGENCIA_MAX_POR_MES=3      # umbral de la regla de abuso de emergencia
# PASSWD_ROTACION_PATRONES_MODO_OBSERVACION=true  # las reglas observan pero no avisan todavía

# --- Agentes de rotación (v1.4.0; docs/plan-rotacion-agentes.md) -------------
# Un agente instalado en el servidor aplica la rotación autorizada, la verifica y
# la revierte si falla. Apagado por defecto: toda rotación sigue el flujo manual.
# PASSWD_AGENTES_ENABLED=false
# PASSWD_AGENTES_TOKEN_VIDA_HORAS=24              # vida de la identidad; se renueva en cada latido
# PASSWD_AGENTES_UMBRAL_SIN_CONTACTO_HORAS=24     # sin latido más que esto -> «sin contacto»
# PASSWD_AGENTES_TELEMETRIA_INTERVALO_MIN=15      # cadencia del latido
# PASSWD_AGENTES_RETENCION_TELEMETRIA_DIAS=30
# PASSWD_AGENTES_VERSION_MINIMA=                  # X.Y.Z; fijada por entorno rige SIN gracia
# PASSWD_AGENTES_GRACIA_VERSION_DIAS=14           # gracia, si la mínima se fija en el panel
# PASSWD_AGENTES_ALERTAR_IP_DISTINTA=true

# --- HTTPS con nginx (docker-compose.nginx.yml) ------------------------------
# Dominio con el que se sirve la aplicación; nginx lo usa como server_name.
# Para pruebas locales puede dejarse en localhost (certificado autofirmado).
PASSWD_DOMAIN=passwd.su-organizacion.tld

# --- Base de datos -----------------------------------------------------------
# Por defecto: SQLite en ${PASSWD_DATA_DIR}/passwd.db
# Para MySQL:  mysql+pymysql://usuario:clave@host:3306/passwd
# PASSWD_DATABASE_URL=

# --- Sesiones y política de cuentas (valores por defecto razonables) ---------
# Nota: la mayoría de estos ajustes operativos (sesión, cuentas, tasa, rotación,
# auditoría y correo/SMTP) también se pueden cambiar EN CALIENTE desde la pantalla
# «Configuración» (solo admin). Un cambio hecho ahí PREVALECE sobre estas variables
# hasta que se restablezca. Ver docs/referencia-configuracion.md §12.
# PASSWD_SESSION_IDLE_MINUTES=15
# PASSWD_SESSION_MAX_HOURS=8
# PASSWD_COOKIE_SECURE=true
# PASSWD_PASSWORD_MIN_LENGTH=12
# PASSWD_MAX_FAILED_ATTEMPTS=5
# PASSWD_LOCKOUT_MINUTES=15
# PASSWD_AUDIT_RETENTION_DAYS=365
# PASSWD_ROTATION_MAX_DAYS=90    # días sin rotar una credencial antes de alertar
# PASSWD_TOTP_ISSUER=Gestor-Passwd

# --- Inventario y rotación ---------------------------------------------------
# PASSWD_PASSWORD_HISTORY_MAX=5     # contraseñas anteriores conservadas por credencial

# --- Servidor de correo (SMTP) -------------------------------------------------
# Base de todo lo que la app envía: códigos de verificación, contraseñas
# temporales, alertas y avisos. Editable también desde Configuración.
# PASSWD_SMTP_ENABLED=false        # interruptor del servicio (si no se define, hereda NOTIFY_ENABLED)
# PASSWD_SMTP_HOST=
# PASSWD_SMTP_PORT=587
# PASSWD_SMTP_SECURITY=starttls    # starttls (587) | ssl (465) | ninguna (solo relés internos)
# PASSWD_SMTP_USER=
# PASSWD_SMTP_PASSWORD=            # o PASSWD_SMTP_PASSWORD_FILE (Docker secrets)
# PASSWD_SMTP_FROM=passwd@su-organizacion.tld
# PASSWD_SMTP_TLS=true             # OBSOLETA: use PASSWD_SMTP_SECURITY

# --- Notificaciones (requieren el servicio de correo; nunca llevan secretos) ---
# PASSWD_NOTIFY_ENABLED=false      # alertas de seguridad a administradores
# PASSWD_NOTIFY_TO=seguridad@su-organizacion.tld   # destinatarios separados por coma
# PASSWD_NOTIFY_USERS_ENABLED=true # avisos a cada usuario en su buzón
# PASSWD_ROTATION_WARNING_DAYS=14  # antelación del aviso de rotación

# --- Verificación en dos pasos -------------------------------------------------
# PASSWD_EMAIL_OTP_PRIMARY_ENABLED=true   # el usuario puede elegir el correo como método principal
# PASSWD_MFA_TOTP_REQUIRED_ADMIN=true     # los administradores deben usar aplicación autenticadora
# PASSWD_EMAIL_OTP_ENABLED=true           # correo como respaldo de quien usa aplicación
# PASSWD_EMAIL_OTP_TTL_MINUTES=10         # validez del código enviado por correo

# --- Escalado horizontal -----------------------------------------------------
# Limitador de tasa compartido entre instancias: "memoria" (por defecto) o "bd"
# PASSWD_RATE_LIMIT_BACKEND=memoria

# --- Proxy inverso -----------------------------------------------------------
# Proxies de confianza para X-Forwarded-For (CSV de IPs o "*"). Con nginx
# delante, actívalo para que la auditoría y el límite de tasa usen la IP real
# del cliente y no la del proxy. Vacío = desactivado.
# PASSWD_TRUSTED_PROXIES=

# --- Endurecimiento OWASP ----------------------------------------------------
# Máximo de revelados/copiados de contraseñas por usuario en la ventana (anti-exfiltración)
# PASSWD_REVEAL_RATE_LIMIT=20
# PASSWD_REVEAL_RATE_WINDOW_MINUTES=5
# Tamaño máximo del cuerpo de una petición en bytes (OWASP API4)
# PASSWD_MAX_REQUEST_BYTES=65536

# --- Respaldos automatizados -------------------------------------------------
# Frase de cifrado para `python -m app.cli respaldo` sin interacción (cron).
# Custodiarla fuera del servidor; sin ella el respaldo es irrecuperable.
# PASSWD_BACKUP_PASSPHRASE=

# --- Solo si se usa la variante MySQL (docker-compose.mysql.yml) -------------
# Descomentar la línea (quitar el '#') y NO dejar espacios alrededor del '='.
# Arranque: docker compose -f docker-compose.yml -f docker-compose.mysql.yml up -d --build
# MYSQL_PASSWORD=

# --- Otros (para que esta referencia sea completa) ---------------------------
# PASSWD_APP_NAME=Gestor de Contraseñas de Servidores
# PASSWD_DATA_DIR=./data
# PASSWD_LOGIN_RATE_LIMIT=15            # intentos de acceso por origen en la ventana
# PASSWD_LOGIN_RATE_WINDOW_MINUTES=5
# PASSWD_ACTIVITY_THROTTLE_SECONDS=60   # técnico; nunca supera media ventana de inactividad
# PASSWD_DB_POOL_SIZE=5                 # solo motores cliente/servidor (MySQL)
# PASSWD_DB_MAX_OVERFLOW=10
# PASSWD_DB_POOL_RECYCLE_SECONDS=1800
