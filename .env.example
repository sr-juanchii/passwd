# Copie este archivo a `.env` y ajuste los valores. NUNCA versione `.env`.

# --- Administrador inicial (solo se usa si no existen usuarios) -------------
PASSWD_ADMIN_USERNAME=admin
PASSWD_ADMIN_EMAIL=admin@su-organizacion.tld
# Contraseña de un solo uso: el sistema fuerza su cambio en el primer acceso
PASSWD_ADMIN_PASSWORD=CambiarEsteValorInicial!2026

# --- Claves criptográficas ---------------------------------------------------
# Si se omiten, se generan automáticamente y se guardan con permisos 0600 en
# el directorio de datos. En producción se recomienda fijarlas y custodiarlas
# en un gestor de secretos.
# PASSWD_SECRET_KEY=
# PASSWD_ENCRYPTION_KEY=   # clave Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- HTTPS con nginx (docker-compose.nginx.yml) ------------------------------
# Dominio con el que se sirve la aplicación; nginx lo usa como server_name.
# Para pruebas locales puede dejarse en localhost (certificado autofirmado).
PASSWD_DOMAIN=passwd.su-organizacion.tld

# --- Base de datos -----------------------------------------------------------
# Por defecto: SQLite en ${PASSWD_DATA_DIR}/passwd.db
# Para MySQL:  mysql+pymysql://usuario:clave@host:3306/passwd
# PASSWD_DATABASE_URL=

# --- Sesiones y política de cuentas (valores por defecto razonables) ---------
# PASSWD_SESSION_IDLE_MINUTES=15
# PASSWD_SESSION_MAX_HOURS=8
# PASSWD_COOKIE_SECURE=true
# PASSWD_PASSWORD_MIN_LENGTH=12
# PASSWD_MAX_FAILED_ATTEMPTS=5
# PASSWD_LOCKOUT_MINUTES=15
# PASSWD_AUDIT_RETENTION_DAYS=365
# PASSWD_ROTATION_MAX_DAYS=90    # días sin rotar una credencial antes de alertar
# PASSWD_TOTP_ISSUER=Gestor-Passwd

# --- Inventario y rotación ---------------------------------------------------
# PASSWD_PASSWORD_HISTORY_MAX=5     # contraseñas anteriores conservadas por credencial

# --- Notificaciones por correo (opt-in; los correos nunca llevan secretos) ---
# PASSWD_NOTIFY_ENABLED=false
# PASSWD_SMTP_HOST=
# PASSWD_SMTP_PORT=587
# PASSWD_SMTP_USER=
# PASSWD_SMTP_PASSWORD=
# PASSWD_SMTP_FROM=alertas@su-organizacion.tld
# PASSWD_SMTP_TLS=true
# PASSWD_NOTIFY_TO=seguridad@su-organizacion.tld   # destinatarios separados por coma

# --- Escalado horizontal -----------------------------------------------------
# Limitador de tasa compartido entre instancias: "memoria" (por defecto) o "bd"
# PASSWD_RATE_LIMIT_BACKEND=memoria

# --- Endurecimiento OWASP ----------------------------------------------------
# Máximo de revelados/copiados de contraseñas por usuario en la ventana (anti-exfiltración)
# PASSWD_REVEAL_RATE_LIMIT=20
# PASSWD_REVEAL_RATE_WINDOW_MINUTES=5
# Tamaño máximo del cuerpo de una petición en bytes (OWASP API4)
# PASSWD_MAX_REQUEST_BYTES=65536

# --- Respaldos automatizados -------------------------------------------------
# Frase de cifrado para `python -m app.cli respaldo` sin interacción (cron).
# Custodiarla fuera del servidor; sin ella el respaldo es irrecuperable.
# PASSWD_BACKUP_PASSPHRASE=

# --- Solo si se usa la variante MySQL (docker-compose.mysql.yml) -------------
# Descomentar la línea (quitar el '#') y NO dejar espacios alrededor del '='.
# Arranque: docker compose -f docker-compose.yml -f docker-compose.mysql.yml up -d --build
# MYSQL_PASSWORD=
