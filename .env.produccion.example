# ==========================================================================
#  passwd — PLANTILLA DE PRODUCCIÓN
#  Copia este archivo a `.env` en el servidor de producción y rellena los
#  secretos. NUNCA lo versiones con valores reales (los .env reales están en
#  .gitignore; solo se versionan los *.example).
#
#  Arranque (Docker + MySQL + nginx TLS + frontend Next):
#    docker compose -f docker-compose.yml \
#                   -f docker-compose.frontend.yml \
#                   -f docker-compose.mysql.yml up -d --build
#
#  Reglas de oro:
#   - Cada ambiente (prod/preprod/calidad) usa SUS PROPIAS claves y BD. Nunca
#     compartas PASSWD_SECRET_KEY ni PASSWD_ENCRYPTION_KEY entre ambientes.
#   - Genera las claves cripto y pégalas ABAJO antes de desplegar.
#   - chmod 600 .env
# ==========================================================================

# --- Identidad / acceso por nginx ------------------------------------------
# server_name de nginx. Con dominio: passwd.empresa.tld. Sin dominio: la IP
# interna del servidor (ver docs/ambientes.md y los scripts de certificado).
PASSWD_DOMAIN=passwd.empresa.tld

# --- Administrador inicial (solo se usa en el PRIMER arranque) --------------
PASSWD_ADMIN_USERNAME=admin
PASSWD_ADMIN_EMAIL=admin@empresa.tld
# De un solo uso: el sistema fuerza su cambio + enrolar MFA en el primer acceso.
PASSWD_ADMIN_PASSWORD=CAMBIAR-Arranque-Unico-2026!

# --- Claves criptográficas (OBLIGATORIO fijarlas y custodiarlas) -----------
# Genera valores ÚNICOS para producción (no los reutilices en otros ambientes):
#   PASSWD_SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   PASSWD_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si las dejas vacías se autogeneran en el volumen de datos: si ese volumen se
# pierde o escalas a varias réplicas, TODO lo cifrado en MySQL queda ilegible.
PASSWD_SECRET_KEY=
PASSWD_ENCRYPTION_KEY=

# --- Base de datos: MySQL (vía docker-compose.mysql.yml) -------------------
# Construye la URL y crea el servicio `db` (base `passwd`, usuario `passwd`).
# Evita @ : / ? en la contraseña (se interpola dentro de la URL de conexión).
MYSQL_PASSWORD=CAMBIAR_clave_fuerte_mysql_prod
# NO definas PASSWD_DATABASE_URL aquí: el overlay MySQL la fija y prevalece.
# (Solo si usas un MySQL EXTERNO sin el servicio `db`, comenta MYSQL_PASSWORD y usa:)
# PASSWD_DATABASE_URL=mysql+pymysql://passwd:CLAVE@mysql-prod:3306/passwd

# --- Sesiones y cookies -----------------------------------------------------
PASSWD_COOKIE_SECURE=true        # producción SIEMPRE true (hay HTTPS por nginx)
PASSWD_SESSION_IDLE_MINUTES=15
PASSWD_SESSION_MAX_HOURS=8

# --- Política de cuentas y bloqueo ------------------------------------------
PASSWD_PASSWORD_MIN_LENGTH=12
PASSWD_MAX_FAILED_ATTEMPTS=5
PASSWD_LOCKOUT_MINUTES=15

# --- Limitación de tasa -----------------------------------------------------
PASSWD_LOGIN_RATE_LIMIT=15
PASSWD_LOGIN_RATE_WINDOW_MINUTES=5
PASSWD_REVEAL_RATE_LIMIT=20
PASSWD_REVEAL_RATE_WINDOW_MINUTES=5
# "memoria" = una sola instancia de la app. Con VARIAS réplicas usa "bd".
PASSWD_RATE_LIMIT_BACKEND=memoria

# --- Endurecimiento / recursos ----------------------------------------------
PASSWD_MAX_REQUEST_BYTES=65536

# --- Auditoría y rotación ---------------------------------------------------
PASSWD_AUDIT_RETENTION_DAYS=365
PASSWD_ROTATION_MAX_DAYS=90
PASSWD_PASSWORD_HISTORY_MAX=5

# --- MFA --------------------------------------------------------------------
PASSWD_TOTP_ISSUER=passwd-PROD   # etiqueta que verán en su app autenticadora

# --- Notificaciones por correo (alertas de seguridad; NUNCA llevan secretos) -
PASSWD_NOTIFY_ENABLED=true
PASSWD_SMTP_HOST=smtp.empresa.tld
PASSWD_SMTP_PORT=587
PASSWD_SMTP_USER=passwd-alertas@empresa.tld
PASSWD_SMTP_PASSWORD=CAMBIAR_clave_smtp
PASSWD_SMTP_FROM=passwd-alertas@empresa.tld
PASSWD_SMTP_TLS=true
PASSWD_NOTIFY_TO=seguridad@empresa.tld,soc@empresa.tld

# --- Respaldos cifrados desatendidos (python -m app.cli respaldo) -----------
# Custódiala FUERA del servidor; sin ella el respaldo es irrecuperable.
PASSWD_BACKUP_PASSPHRASE=CAMBIAR_frase_larga_respaldo_prod
