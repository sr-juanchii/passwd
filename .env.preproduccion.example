# ==========================================================================
#  passwd — PLANTILLA DE PRE-PRODUCCIÓN (staging)
#  Réplica fiel de producción para validar despliegues/migraciones antes del
#  salto a prod. Mismas opciones de seguridad que prod, pero con SUS PROPIAS
#  claves, BD, dominio y destinatarios (jamás compartas secretos con prod).
#
#  Copia a `.env` en el servidor de pre-producción.
#  Arranque:
#    docker compose -f docker-compose.yml \
#                   -f docker-compose.frontend.yml \
#                   -f docker-compose.mysql.yml up -d --build
# ==========================================================================

# --- Identidad / acceso por nginx ------------------------------------------
PASSWD_DOMAIN=preprod.passwd.empresa.tld

# --- Administrador inicial (solo primer arranque) --------------------------
PASSWD_ADMIN_USERNAME=admin
PASSWD_ADMIN_EMAIL=admin-preprod@empresa.tld
PASSWD_ADMIN_PASSWORD=CAMBIAR-Preprod-Unico-2026!

# --- Claves criptográficas (ÚNICAS para preprod; no las de prod) -----------
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSWD_REQUIRE_ENV_KEYS=true     # como prod: sin claves por entorno, no arranca
PASSWD_SECRET_KEY=
PASSWD_ENCRYPTION_KEY=

# --- Base de datos: MySQL (servicio `db` del overlay) ----------------------
MYSQL_PASSWORD=CAMBIAR_clave_fuerte_mysql_preprod
# PASSWD_DATABASE_URL=mysql+pymysql://passwd:CLAVE@mysql-preprod:3306/passwd

# --- Sesiones y cookies -----------------------------------------------------
PASSWD_COOKIE_SECURE=true        # preprod detrás de HTTPS (como prod)
PASSWD_SESSION_IDLE_MINUTES=15
PASSWD_SESSION_MAX_HOURS=8

# --- Política de cuentas / tasa / recursos (igual que prod) ----------------
PASSWD_PASSWORD_MIN_LENGTH=12
PASSWD_MAX_FAILED_ATTEMPTS=5
PASSWD_LOCKOUT_MINUTES=15
PASSWD_LOGIN_RATE_LIMIT=15
PASSWD_LOGIN_RATE_WINDOW_MINUTES=5
PASSWD_REVEAL_RATE_LIMIT=20
PASSWD_REVEAL_RATE_WINDOW_MINUTES=5
PASSWD_RATE_LIMIT_BACKEND=bd     # compartido entre procesos (como prod)
PASSWD_MAX_REQUEST_BYTES=65536
PASSWD_TRUSTED_PROXIES=*         # IP real del cliente tras nginx (como prod)

# --- Auditoría y rotación ---------------------------------------------------
PASSWD_AUDIT_RETENTION_DAYS=365
PASSWD_ROTATION_MAX_DAYS=90
PASSWD_PASSWORD_HISTORY_MAX=5

# --- MFA --------------------------------------------------------------------
PASSWD_TOTP_ISSUER=passwd-PREPROD

# --- Notificaciones (a destinatarios de preprod, para validar el envío) ----
PASSWD_NOTIFY_ENABLED=true
PASSWD_SMTP_HOST=smtp.empresa.tld
PASSWD_SMTP_PORT=587
PASSWD_SMTP_USER=passwd-alertas-preprod@empresa.tld
PASSWD_SMTP_PASSWORD=CAMBIAR_clave_smtp
PASSWD_SMTP_FROM=passwd-alertas-preprod@empresa.tld
PASSWD_SMTP_TLS=true
PASSWD_NOTIFY_TO=equipo-preprod@empresa.tld

# --- Respaldos cifrados (valida el procedimiento antes de prod) ------------
PASSWD_BACKUP_PASSPHRASE=CAMBIAR_frase_respaldo_preprod
