{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=*",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "environments": {
    "production": {
      "variables": {
        "PASSWD_DATABASE_URL": "mysql+pymysql://${{MYSQLUSER}}:${{MYSQLPASSWORD}}@${{MYSQLHOST}}:${{MYSQLPORT}}/${{MYSQLDATABASE}}",
        "PASSWD_DOMAIN": "${{PASSWD_DOMAIN}}",
        "PASSWD_SECRET_KEY": "${{PASSWD_SECRET_KEY}}",
        "PASSWD_ENCRYPTION_KEY": "${{PASSWD_ENCRYPTION_KEY}}",
        "PASSWD_ADMIN_USERNAME": "${{PASSWD_ADMIN_USERNAME}}",
        "PASSWD_ADMIN_EMAIL": "${{PASSWD_ADMIN_EMAIL}}",
        "PASSWD_ADMIN_PASSWORD": "${{PASSWD_ADMIN_PASSWORD}}",
        "PASSWD_COOKIE_SECURE": "true",
        "PASSWD_RATE_LIMIT_BACKEND": "bd"
      }
    }
  }
}
