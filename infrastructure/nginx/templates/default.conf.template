# ── Gestor de Contraseñas de Servidores — terminación TLS con nginx ──────────
# Esta plantilla se procesa con envsubst al arrancar el contenedor: SOLO se
# sustituyen las variables que empiezan por PASSWD_ (NGINX_ENVSUBST_FILTER),
# de modo que las variables propias de nginx ($host, $remote_addr, …) quedan
# intactas. El resultado reemplaza /etc/nginx/conf.d/default.conf.
#
# Los certificados se leen SIEMPRE de /etc/nginx/certs/{fullchain,privkey}.pem.
# Así la rotación es siempre la misma operación —reemplazar esos dos archivos y
# recargar nginx— sin importar el emisor (CA interna, Let's Encrypt o prueba).

server_tokens off;

# ── HTTP (80): solo desafío ACME y redirección permanente a HTTPS ────────────
# Solo IPv4 por compatibilidad (muchos Docker traen IPv6 deshabilitado y un
# `listen [::]` impediría arrancar). Para doble pila, añada las líneas
# `listen [::]:80;` y `listen [::]:443 ssl;` (ver guía §7).
server {
    listen 80 default_server;
    server_name ${PASSWD_DOMAIN};

    # Renovación de Let's Encrypt por webroot (ver guía §4).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS (443): proxy inverso hacia la aplicación ───────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${PASSWD_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Perfil "intermediate" de Mozilla: TLS 1.2/1.3, solo ECDHE (no requiere
    # dhparam). TLS 1.0/1.1 y SSLv3 quedan deshabilitados.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:tls_passwd:10m;
    ssl_session_tickets off;

    # OCSP stapling: efectivo con certificados emitidos por una CA pública;
    # inocuo (se ignora con un aviso) en certificados autofirmados de prueba.
    # Requiere un resolvedor DNS: el interno de Docker (127.0.0.11).
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=300s;
    resolver_timeout 5s;

    # HSTS: nginx es el ÚNICO emisor de esta cabecera (oculta la que envía la
    # app y fija la suya) para no duplicarla y cubrir también las páginas de
    # error del propio nginx. El resto de cabeceras de seguridad (CSP, etc.)
    # las emite la aplicación y se reenvían tal cual.
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # La aplicación aplica su propio límite (64 KB); nginx corta abusos brutos.
    client_max_body_size 1m;

    # ── nginx detrás de OTRO proxy/balanceador (opcional) ────────────────────
    # Por defecto, nginx es el borde y $remote_addr es la IP del cliente final.
    # Si nginx queda detrás de un balanceador, descomente y ajuste la(s) red(es)
    # de confianza: el módulo realip reemplaza $remote_addr por la IP real del
    # cliente tomada de X-Forwarded-For (solo desde redes de confianza), de modo
    # que el `proxy_set_header X-Forwarded-For $remote_addr` de abajo siga
    # reenviando la IP correcta. No use $realip_remote_addr aquí: esa variable
    # conserva la IP del balanceador, no la del cliente.
    #set_real_ip_from 10.0.0.0/8;        # red del balanceador aguas arriba
    #real_ip_header X-Forwarded-For;
    #real_ip_recursive on;

    location / {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;

        # IP real del cliente para la auditoría: se SOBRESCRIBE X-Forwarded-For
        # con la dirección que observa nginx ($remote_addr, ya resuelta por
        # realip si está configurado arriba), descartando cualquier valor que
        # el cliente intente inyectar (anti-spoofing del registro).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host $host;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
