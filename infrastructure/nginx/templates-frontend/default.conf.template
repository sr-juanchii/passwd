# ── Gestor de Contraseñas — TLS con nginx delante del frontend Next.js ───────
# Enruta:  /api/* y /healthz  -> backend FastAPI (app:8000)
#          el resto            -> frontend Next.js (frontend:3000)
#
# Procesada con envsubst al arrancar (solo variables PASSWD_*). Los certificados
# se leen de /etc/nginx/certs/{fullchain,privkey}.pem (rotación: reemplazar y recargar).

server_tokens off;

# ── Rate limiting y compresión (contexto http; los .conf de conf.d viven ahí) ─
# Defensa en profundidad ANTES de llegar a la app (que ya limita login/revelado).
limit_req_zone $binary_remote_addr zone=passwd_req:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=passwd_login:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=passwd_conn:10m;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_types text/plain text/css application/json application/javascript
           application/x-javascript text/xml application/xml image/svg+xml;

# ── HTTP (80): desafío ACME y redirección a HTTPS ────────────────────────────
server {
    listen 80 default_server;
    server_name ${PASSWD_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS (443) ──────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${PASSWD_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:tls_passwd:10m;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=300s;
    resolver_timeout 5s;

    # HSTS la emite nginx (ÚNICO emisor: oculta la del upstream y fija la suya,
    # cubriendo también las páginas de error del propio nginx). El resto de
    # cabeceras de seguridad las emite cada upstream sin duplicarse: el backend
    # FastAPI para /api/* y Next (headers() en next.config.ts: CSP,
    # Permissions-Policy, nosniff, X-Frame-Options, Referrer-Policy) para las
    # páginas del frontend.
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Huella tecnológica: Next ya no emite X-Powered-By (poweredByHeader: false
    # en next.config.ts); se oculta también en el borde por si un upstream
    # futuro la reintroduce.
    proxy_hide_header X-Powered-By;

    client_max_body_size 4m;
    limit_conn passwd_conn 30;

    # ── Barrera de acceso al código fuente (defensa en profundidad) ──────────
    # Estas reglas NO evitan que el navegador lea el JavaScript que sí necesita
    # ejecutar (eso es imposible: ver docs/proteccion-codigo-fuente.md). Cortan
    # el acceso a artefactos que revelan el código ORIGINAL y que nunca deben
    # servirse en producción, aunque un build mal configurado los publique.

    # Mapas de origen (*.map): reconstruyen el TypeScript original con nombres
    # de variables y comentarios. El build los desactiva; aquí se niegan además
    # en el borde, para que un `productionBrowserSourceMaps: true` accidental no
    # se traduzca en una fuga de código.
    location ~* \.(map|ts|tsx)$ {
        access_log off;
        return 404;
    }

    # Metadatos de repositorio y de entorno: /.git/, /.env, /.svn/, editores.
    # Escaneos automatizados los prueban de forma rutinaria contra cualquier
    # dominio público. Se excluye /.well-known/ (ACME) que sí es legítimo.
    location ~ ^/\.(?!well-known/) {
        access_log off;
        return 404;
    }

    # ── nginx detrás de OTRO proxy (opcional, ver guía-nginx-tls.md §realip) ──
    #set_real_ip_from 10.0.0.0/8;
    #real_ip_header X-Forwarded-For;
    #real_ip_recursive on;

    # Estáticos inmutables de Next (hash en el nombre): caché larga en el cliente.
    location /_next/static/ {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # API JSON y de tokens + healthcheck -> backend FastAPI.
    location ~ ^/(api/|healthz) {
        limit_req zone=passwd_req burst=40 nodelay;
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $remote_addr;     # anti-spoofing del registro
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Endpoints de login/MFA: límite de borde más estricto (anti fuerza bruta).
    location ~ ^/(login|mfa|password) {
        limit_req zone=passwd_login burst=10 nodelay;
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Todo lo demás -> frontend Next.js.
    location / {
        limit_req zone=passwd_req burst=40 nodelay;
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
